{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=lumina_db;Username=postgres;Password=your_password;"
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "BucketName": "lumora-media",
    "UseSSL": true
  },
  "Security": {
    "Pbkdf2": {
      "IterationCount": 10000,
      "HashLength": 32,
      "Algorithm": "HMACSHA256"
    },
    "Jwt": {
      "SecretKey": "your-long-secret-key-min-32-chars",
      "AccessTokenExpiryMinutes": 60,
      "RefreshTokenExpiryHours": 24
    }
  },
  "Razorpay": {
    "Key": "rzp_test_lumora_simulated_key",
    "Secret": "lumora_simulated_secret",
    "MerchantUpiId": "lumora.razorpay@icici",
    "PlatformFeePercentage": 0.05,
    "MinSimulationDelaySeconds": 5,
    "MaxSimulationDelaySeconds": 25
  }
}
