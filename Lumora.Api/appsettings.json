{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=lumina_db;Username=postgres;Password=your_password;"
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "BucketName": "lumora-media",
    "UseSSL": false
  },
  "Security": {
    "Pbkdf2": {
      "IterationCount": 10000,
      "HashLength": 32,
      "Algorithm": "HMACSHA256"
    },
    "Jwt": {
      "SecretKey": "your-long-secret-key-min-32-chars",
      "AccessTokenExpiryMinutes": 60,
      "RefreshTokenExpiryHours": 24
    }
  }
}
